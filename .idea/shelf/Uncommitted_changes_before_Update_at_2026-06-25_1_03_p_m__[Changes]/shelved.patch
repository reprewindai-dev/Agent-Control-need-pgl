+export const TelemetryChart: React.FC<TelemetryChartProps> = ({ data }) => {
+  return (
+    <div className="w-full h-32 bg-black/20 rounded-lg p-2 border border-white/5">
+      <ResponsiveContainer width="100%" height="100%" minWidth={0} minHeight={0}>
