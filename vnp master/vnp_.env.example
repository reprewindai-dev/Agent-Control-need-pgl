# ============================================================================
# VNP v0.1 ENVIRONMENT VARIABLES
# 
# Copy this file to .env and fill in all values
# NEVER commit .env to GitHub (add to .gitignore)
# ============================================================================

# ============================================================================
# MEASUREMENT NODES (Regional Configuration)
# ============================================================================

# Which region is this node deployed in?
# Options: us-east, us-west, eu-west, ap-southeast, ap-northeast
REGION=us-east

# Unique identifier for this measurement node
# Format: vnp-{region}-{number}
NODE_ID=vnp-us-east-1

# Operator of this node (for attribution in measurements)
# Can be company name, individual, institution
NODE_OPERATOR_ID=acme-labs-1

# ============================================================================
# KAFKA CONFIGURATION (Message streaming)
# ============================================================================

# Kafka broker addresses (comma-separated for cluster)
# Example for local: localhost:9092
# Example for production: kafka-1.vnp.io:9092,kafka-2.vnp.io:9092,kafka-3.vnp.io:9092
KAFKA_BROKERS=kafka:9092

# Kafka topic for raw measurements
KAFKA_TOPIC_MEASUREMENTS=vnp-measurements

# Kafka topic for computed scores
KAFKA_TOPIC_SCORES=vnp-scores

# ============================================================================
# CLICKHOUSE CONFIGURATION (Time-series database)
# ============================================================================

# ClickHouse server hostname/IP
CLICKHOUSE_HOST=clickhouse

# ClickHouse server port (9000 is native protocol, 8123 is HTTP)
CLICKHOUSE_PORT=9000

# Database name
CLICKHOUSE_DB=vnp

# ClickHouse username (default: 'default')
CLICKHOUSE_USER=default

# ClickHouse password (empty by default in dev; set in production)
CLICKHOUSE_PASSWORD=

# HTTP interface (for dashboards, debugging)
CLICKHOUSE_HTTP_PORT=8123

# ============================================================================
# MEASUREMENT AGENT CONFIGURATION (k6)
# ============================================================================

# Duration of each measurement run (in seconds)
# Default: 300 (5 minutes)
MEASUREMENT_DURATION_SECONDS=300

# Number of concurrent requests during measurement
# Default: 10
CONCURRENT_REQUESTS=10

# Total requests to execute per API per measurement
# Default: 1000
TOTAL_REQUESTS_PER_API=1000

# Comma-separated list of APIs to measure
# Example: stripe-payments,openai-api,anthropic-api,cloudflare-ai,google-inference
API_TARGETS=stripe-payments,openai-api,anthropic-api,cloudflare-ai,google-inference

# ============================================================================
# SCORING ENGINE CONFIGURATION (Python)
# ============================================================================

# Methodology version (LOCKED - do not change without governance vote)
METHODOLOGY_VERSION=0.1.0

# Date methodology is locked until (YYYY-MM-DD)
# Format: YYYY-MM-DD
METHODOLOGY_LOCKED_UNTIL=2027-06-22

# Scoring engine scheduling (cron format, runs hourly)
# Default: "0 * * * *" (every hour at minute 0)
SCORING_SCHEDULE=0 * * * *

# ============================================================================
# BLOCKCHAIN CONFIGURATION (Base L2)
# ============================================================================

# Base L2 RPC endpoint
# Production: https://mainnet.base.org
# Testnet: https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# VNP Anchor contract address on Base L2
# After deployment, fill in actual address
# Example: 0x1234567890123456789012345678901234567890
VNP_ANCHOR_CONTRACT_ADDRESS=0x

# VNP issuer's Ethereum private key (for signing measurements and anchors)
# NEVER commit this to GitHub
# Format: 0x... (hex string)
# Get from AWS Secrets Manager or similar secure storage
VNP_ISSUER_PRIVATE_KEY=0x

# VNP issuer's Ethereum address (for verification)
VNP_ISSUER_ADDRESS=0x

# Gas price multiplier (for congestion periods)
# Default: 1.0 (use network gas price)
GAS_PRICE_MULTIPLIER=1.0

# Max gas price willing to pay (in gwei)
# Default: 100 (Base L2 is cheap, usually <1 gwei)
MAX_GAS_PRICE_GWEI=100

# ============================================================================
# IPFS CONFIGURATION (Data archival)
# ============================================================================

# IPFS node type: local, pinata, or nft.storage
IPFS_PROVIDER=pinata

# Pinata API key (for IPFS pinning)
# Get from https://app.pinata.cloud
# Leave empty if using local IPFS
PINATA_API_KEY=

# Pinata secret key
PINATA_SECRET_KEY=

# Local IPFS node address (if using local provider)
# Default: http://localhost:5001
LOCAL_IPFS_API_URL=http://localhost:5001

# ============================================================================
# PUBLIC API CONFIGURATION (GraphQL + REST)
# ============================================================================

# Public API server port
# Default: 4000
API_PORT=4000

# GraphQL endpoint path
# Default: /graphql
GRAPHQL_ENDPOINT=/graphql

# REST API endpoint base path
# Default: /v1
REST_ENDPOINT=/v1

# API rate limiting (requests per time window)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MINUTES=60

# CORS allowed origins (comma-separated)
# * = allow all (not recommended for production)
# Example: https://vnp.io,https://app.vnp.io
CORS_ALLOWED_ORIGINS=*

# Enable GraphQL introspection (for development)
# Disable (false) in production
GRAPHQL_INTROSPECTION_ENABLED=true

# ============================================================================
# DASHBOARD CONFIGURATION (Next.js)
# ============================================================================

# Next.js environment
# Options: development, production
NODE_ENV=production

# Public API URL (for dashboard to call backend)
# Example: https://api.vnp.io
NEXT_PUBLIC_API_URL=http://localhost:4000

# GraphQL API URL
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Blockchain chain name
NEXT_PUBLIC_CHAIN=base

# Base L2 public RPC (for wallet connections, if enabled)
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org

# Analytics (optional)
# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# OpenTelemetry exporter endpoint (OTLP)
# For Jaeger: http://jaeger:4317
# For DataDog: https://trace.agent.datadoghq.com (requires DD_API_KEY)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Prometheus metrics port
PROMETHEUS_PORT=9090

# Grafana admin password (for dashboards)
GRAFANA_ADMIN_PASSWORD=admin

# PagerDuty integration key (for alerting)
# Leave empty if not using PagerDuty
PAGERDUTY_INTEGRATION_KEY=

# Slack webhook URL (for notifications)
# Example: https://hooks.slack.com/services/YOUR_WEBHOOK_HERE
SLACK_WEBHOOK_URL=

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# Enable structured logging
STRUCTURED_LOGGING=true

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable verbose output
VERBOSE=false

# Skip anti-gaming controls (NEVER in production)
SKIP_ANTI_GAMING_CONTROLS=false

# Measurement dry-run (don't publish to Kafka)
DRY_RUN=false

# Mock API responses (for testing)
MOCK_API_RESPONSES=false

# ============================================================================
# SECURITY
# ============================================================================

# JWT secret for API authentication (if enabled)
# Generate: openssl rand -hex 32
JWT_SECRET=

# API key for admin endpoints
# Generate: uuidgen or openssl rand -hex 16
ADMIN_API_KEY=

# Enable HTTPS for API
# Requires SSL_CERT_PATH and SSL_KEY_PATH
ENABLE_HTTPS=false

# SSL certificate file path (for HTTPS)
SSL_CERT_PATH=/etc/ssl/certs/vnp-api.crt

# SSL private key file path (for HTTPS)
SSL_KEY_PATH=/etc/ssl/private/vnp-api.key

# ============================================================================
# EXPERIMENTAL / FUTURE USE
# ============================================================================

# Feature flags for v0.2 features
ENABLE_DISPUTE_ORACLE=false
ENABLE_CONFORMANCE_TESTING=false
ENABLE_PROVIDER_DASHBOARD=false

# Staking configuration (for v0.2)
STAKING_CONTRACT_ADDRESS=0x
STAKING_TOKEN_ADDRESS=0x

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit .env to Git (add to .gitignore)
# 2. Use AWS Secrets Manager / HashiCorp Vault for production secrets
# 3. Rotate VNP_ISSUER_PRIVATE_KEY annually
# 4. Review CORS_ALLOWED_ORIGINS in production (restrict to vnp.io)
# 5. Enable ENABLE_HTTPS in production
# 6. Set LOG_LEVEL=WARN in production (not DEBUG)
# 7. Disable GRAPHQL_INTROSPECTION_ENABLED in production

# ============================================================================
# QUICK START (LOCAL DEVELOPMENT)
# ============================================================================

# Minimal .env for docker-compose up:
#
# REGION=us-east
# NODE_ID=vnp-test-1
# KAFKA_BROKERS=kafka:9092
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_DB=vnp
# BASE_RPC_URL=https://sepolia.base.org
# API_PORT=4000
# NODE_ENV=development

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================

# Before deploying to production:
# [ ] Set NODE_ENV=production
# [ ] Set LOG_LEVEL=WARN
# [ ] Set GRAPHQL_INTROSPECTION_ENABLED=false
# [ ] Set ENABLE_HTTPS=true
# [ ] Restrict CORS_ALLOWED_ORIGINS to vnp.io
# [ ] Generate new VNP_ISSUER_PRIVATE_KEY
# [ ] Store secrets in AWS Secrets Manager
# [ ] Enable PAGERDUTY_INTEGRATION_KEY for alerts
# [ ] Configure SLACK_WEBHOOK_URL for notifications
# [ ] Set up backup for ClickHouse
# [ ] Enable monitoring (OTEL_EXPORTER_OTLP_ENDPOINT)
# [ ] Review firewall rules (only 443, 80 exposed)
# [ ] Enable DDoS protection on API endpoints
# [ ] Run security scan on all images
# [ ] Test failover procedures
# [ ] Document all configuration decisions
